{
  "name": "pi-ask-user-async",
  "version": "0.1.0",
  "description": "Ask users questions synchronously or asynchronously in Pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "question",
    "async"
  ],
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:integration": "python3 tests/integration.py && python3 tests/tui-integration.py",
    "typecheck": "tsc --noEmit",
    "check:package": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^26.0.0",
    "typebox": "^1.3.27",
    "typescript": "^5.9.3",
    "@earendil-works/pi-tui": "^1.5.0"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tesso57/ask.git"
  },
  "homepage": "https://github.com/tesso57/ask#readme",
  "bugs": {
    "url": "https://github.com/tesso57/ask/issues"
  }
}
