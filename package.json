{
  "name": "pi-ask-user-async",
  "version": "0.1.0",
  "description": "Ask users questions synchronously or asynchronously in Pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "question",
    "async"
  ],
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:integration": "python3 tests/integration.py",
    "typecheck": "tsc --noEmit --module nodenext --target es2022 --moduleResolution nodenext --strict --skipLibCheck extensions/ask.ts --noUnusedLocals --noUnusedParameters"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "26.6.6",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  },
  "pi": {
    "extensions": [
      "./extensions/ask.ts"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tesso57/ask.git"
  },
  "homepage": "https://github.com/tesso57/ask#readme",
  "bugs": {
    "url": "https://github.com/tesso57/ask/issues"
  }
}
